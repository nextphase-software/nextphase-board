  },
  "dependencies": {
    "konva": "10.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-konva": "19.3.2",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }

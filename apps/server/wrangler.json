{
  "name": "nextphase-board-server",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": { "bindings": [
    { "name": "ROOMS", "class_name": "BoardRoom" },
    { "name": "FENCES", "class_name": "RestoreFence" }
  ] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardRoom", "RestoreFence"] }]
}
